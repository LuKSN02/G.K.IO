{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G.K.IO",
  "version": "1.0.0",
  "identifier": "io.gkio.rust",
  "build": {},
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../web": "web",
      "updater.json": "updater.json"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "configurado-em-updater.json",
      "endpoints": [
        "https://github.com/luksn02/G.K.IO/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}