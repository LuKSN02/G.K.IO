{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "O app web do G.K.IO (servido em localhost) conversa com o Rust s\u00f3 pelos comandos listados em src/lib.rs.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "allow-cfg-get",
    "allow-cfg-set",
    "allow-tray-state",
    "allow-shortcuts-set",
    "allow-game-current",
    "allow-streamer-current",
    "allow-update-status",
    "allow-update-check",
    "allow-update-install",
    "allow-cache-clear",
    "allow-open-data",
    "allow-open-logs",
    "allow-safe-mode",
    "allow-fetch-text",
    "allow-profiles-list",
    "allow-profiles-open",
    "allow-profiles-remove",
    "allow-open-external",
    "allow-toggle-devtools",
    "allow-notify",
    "allow-selftest-report",
    "allow-show-window-cmd"
  ]
}