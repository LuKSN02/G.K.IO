rules_version = '2';

// ============================================================
// G.K.IO — Regras de segurança do Firestore (ponto de partida)
// Cole isto em: Console do Firebase > Firestore Database > Regras.
// São regras razoáveis para o MVP/uso com amigos — antes de um
// lançamento público mais amplo, revise com mais rigor (ex.:
// validação de schema de cada campo, rate limiting via App Check).
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return request.auth.uid == uid; }
    function isServerMember(serverId) {
      return request.auth.uid in get(/databases/$(database)/documents/servers/$(serverId)).data.memberIds;
    }
    function isServerOwner(serverId) {
      return request.auth.uid == get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId;
    }
    // Só o dono do servidor ou um membro com cargo 'admin' pode criar/editar/excluir
    // categorias e canais. Membros comuns só têm leitura.
    function canManageChannels(serverId) {
      return isServerOwner(serverId)
        || get(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid)).data.role == 'admin';
    }
    // Edição de mensagem: só o autor, e só pode alterar 'content' e 'editedAt'
    // (autorId, createdAt e anexos ficam travados).
    function isValidMessageEdit() {
      return resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'editedAt']);
    }

    // ---------- Usuários e perfil ----------
    // Campos de status Prime (role, primeSince, customBadges) NUNCA podem
    // ser alterados pelo próprio usuário via client — só mudam manualmente
    // no console do Firebase, ou futuramente via Cloud Function com Admin
    // SDK (ex: webhook de um gateway de pagamento), que ignora estas regras.
    function isValidSelfProfileEdit() {
      return !('role' in resource.data) // primeira escrita (criação do doc) passa livre
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName','avatarUrl','bannerUrl','bannerType','bio','statusPresence','tag','frameStyle']);
    }
    // Um "admin" é definido pelo próprio campo isAdmin no doc do usuário
    // logado — campo que, por sua vez, NENHUMA regra permite o próprio
    // usuário setar (não está em isValidSelfProfileEdit acima), então só
    // vira true manualmente no console do Firebase.
    function isAdminUser() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }
    // Admin só pode tocar em role/primeSince/customBadges de QUALQUER
    // usuário — nada além disso (não pode mudar avatar, bio etc. de outros).
    function isValidAdminBadgeEdit() {
      return isAdminUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','primeSince','customBadges']);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid);
      allow update: if (isSelf(uid) && isValidSelfProfileEdit()) || isValidAdminBadgeEdit();

      match /socialLinks/{linkId} {
        allow read: if signedIn();
        allow write: if isSelf(uid);
      }
    }

    // ---------- Amizades ----------
    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.userIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.userIds;
      allow update: if signedIn() && request.auth.uid in resource.data.userIds;
    }

    // ---------- Mensagens diretas ----------
    match /directMessages/{dmId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds;

      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)).data.participantIds;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)).data.participantIds
          && request.resource.data.authorId == request.auth.uid;
        allow update: if signedIn() && isValidMessageEdit();
      }
    }

    // ---------- Servidores ----------
    // Duas formas de editar o doc do servidor, mutuamente exclusivas:
    // (1) qualquer membro pode mexer SÓ em memberIds (entrar/sair/ser expulso);
    // (2) dono ou admin pode editar nome/descrição/ícone/banner, mas nunca
    //     ownerId ou memberIds por essa via (isso evitaria um admin se
    //     autopromover a dono, ou "roubar" o servidor).
    function isServerAdminOrOwner(serverId) {
      return isServerOwner(serverId)
        || get(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid)).data.role == 'admin';
    }
    function isMemberIdsOnlyChange(serverId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && (request.auth.uid in resource.data.memberIds || request.auth.uid in request.resource.data.memberIds);
    }
    function isValidServerInfoEdit(serverId) {
      return isServerAdminOrOwner(serverId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','iconUrl','bannerUrl']);
    }

    match /servers/{serverId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == request.resource.data.ownerId;
      allow update: if signedIn() && (isMemberIdsOnlyChange(serverId) || isValidServerInfoEdit(serverId));
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      match /categories/{catId} {
        allow read: if signedIn() && isServerMember(serverId);
        allow write: if signedIn() && canManageChannels(serverId);
      }

      match /channels/{channelId} {
        allow read: if signedIn() && isServerMember(serverId);
        allow write: if signedIn() && canManageChannels(serverId);

        match /messages/{msgId} {
          allow read: if signedIn() && isServerMember(serverId);
          allow create: if signedIn() && isServerMember(serverId) && request.resource.data.authorId == request.auth.uid;
          allow update: if signedIn() && isServerMember(serverId) && isValidMessageEdit();
        }

        match /voicePresence/{uid} {
          allow read: if signedIn() && isServerMember(serverId);
          allow write: if signedIn() && isSelf(uid);
        }

        match /voiceSignaling/{pairId} {
          allow read, write: if signedIn() && isServerMember(serverId);

          match /candidates/{candId} {
            allow read, write: if signedIn() && isServerMember(serverId);
          }
        }
      }

      match /members/{uid} {
        allow read: if signedIn() && isServerMember(serverId);
        allow write: if signedIn() && (isSelf(uid) || request.auth.uid == get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId);
      }
    }

    // ---------- Convites ----------
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == request.resource.data.createdBy;
      allow update: if signedIn();
    }

    // ---------- Chamadas (DM) ----------
    match /calls/{callId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow create: if signedIn() && request.auth.uid == request.resource.data.callerId;
      allow update: if signedIn() && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);

      match /candidates/{candId} {
        allow read, write: if signedIn();
      }
    }

    // ---------- Emojis personalizados (biblioteca compartilhada) ----------
    match /customEmojis/{emojiId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uploaderId == request.auth.uid;
      allow delete: if signedIn() && resource.data.uploaderId == request.auth.uid;
    }
  }
}
