rules_version = '2';

// ============================================================
// G.K.IO — Regras de segurança do Firestore (ponto de partida)
// Cole isto em: Console do Firebase > Firestore Database > Regras.
// São regras razoáveis para o MVP/uso com amigos — antes de um
// lançamento público mais amplo, revise com mais rigor (ex.:
// validação de schema de cada campo, rate limiting via App Check).
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return request.auth.uid == uid; }
    function isServerMember(serverId) {
      return request.auth.uid in get(/databases/$(database)/documents/servers/$(serverId)).data.memberIds;
    }
    function isServerOwner(serverId) {
      return request.auth.uid == get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId;
    }
    function myMemberDoc(serverId) {
      return get(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid)).data;
    }
    // Cargos personalizados (ver servers/{id}/roles): a app calcula a união
    // das permissões dos cargos atribuídos e grava uma cópia "achatada" no
    // próprio doc do membro (campo `permissions`), porque as Rules não
    // conseguem percorrer um array de ids e consultar cada cargo dentro de
    // uma mesma regra. Só o dono grava esse campo (ver match /members
    // abaixo), então essa cópia é confiável.
    function hasPermission(serverId, key) {
      return myMemberDoc(serverId).get('permissions', {}).get(key, false) == true;
    }
    // Só o dono do servidor, um membro com cargo legado 'admin', ou um
    // membro com a permissão granular correspondente pode gerenciar
    // canais/categorias. Membros comuns só têm leitura.
    function canManageChannels(serverId) {
      return isServerOwner(serverId)
        || myMemberDoc(serverId).role == 'admin'
        || hasPermission(serverId, 'manageChannels');
    }
    // Edição de mensagem: só o autor, e só pode alterar 'content' e 'editedAt'
    // (autorId, createdAt e anexos ficam travados).
    function isValidMessageEdit() {
      return resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'editedAt']);
    }
    // Reações: diferente da edição, QUALQUER pessoa que enxerga a conversa
    // pode mexer — só no campo 'reactions', sem tocar em mais nada da
    // mensagem (autor, conteúdo, anexo etc. continuam travados). A regra
    // não valida que a pessoa só adicionou/removeu o PRÓPRIO uid dentro do
    // mapa (o Firestore Rules não consegue inspecionar o conteúdo de um
    // arrayUnion/arrayRemove dentro de um mapa aninhado) — mitigado no
    // client, que só chama arrayUnion(auth.uid)/arrayRemove(auth.uid).
    function isValidReactionUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    // Votos de enquete: qualquer pessoa da conversa, só no campo 'votes' e só
    // enquanto a enquete não foi encerrada.
    function isValidVoteUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && !resource.data.get('pollClosed', false)
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    // Encerrar a enquete: só o autor, só o campo 'pollClosed'.
    function isValidPollClose() {
      return resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pollClosed'])
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    // Tópicos (threads): quem enxerga a conversa pode mexer SÓ no contador de respostas da
    // mensagem-mãe (threadCount / threadLastAt), de 1 em 1 — +1 ao responder, -1 ao apagar.
    function isValidThreadCounterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['threadCount', 'threadLastAt'])
        && request.resource.data.threadCount is int
        && request.resource.data.threadCount >= 0
        && math.abs(request.resource.data.threadCount - resource.data.get('threadCount', 0)) <= 1
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    function isValidThreadReply() {
      return request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 2000;
    }
    // Fixar/desafixar mensagem: só os campos de pin. QUEM pode fixar é decidido
    // por quem chama (canal: quem gerencia canais; DM: qualquer participante).
    function isValidPinUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned', 'pinnedBy', 'pinnedAt'])
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // ---------- Usuários e perfil ----------
    // Campos de status Prime (role, primeSince, customBadges) NUNCA podem
    // ser alterados pelo próprio usuário via client — só mudam manualmente
    // no console do Firebase, ou futuramente via Cloud Function com Admin
    // SDK (ex: webhook de um gateway de pagamento), que ignora estas regras.
    function isValidUsername(u) {
      return u is string && u.size() >= 3 && u.size() <= 32 && u.matches('^[a-z0-9_-]+$');
    }
    function isValidSelfProfileEdit() {
      return !('role' in resource.data) // primeira escrita (criação do doc) passa livre
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName','avatarUrl','bannerUrl','bannerType','bio','statusPresence','lastActiveAt','tag','frameStyle','username','fcmToken','wallpaper','wallpaperUrl','activity','notifPrefs','pronouns','customStatus','avatarHistory','privacy','profileTheme','profileEffect','nameplate','blockedUids','email'])
          // Personalização de perfil (tema/efeito/placa são cosméticos Prime — a checagem de Prime é no app;
          // aqui só validamos formato e tamanho)
          && (!('pronouns' in request.resource.data) || (request.resource.data.pronouns is string && request.resource.data.pronouns.size() <= 32))
          && (!('customStatus' in request.resource.data) || request.resource.data.customStatus == null
              || (request.resource.data.customStatus is map
                  && request.resource.data.customStatus.text is string && request.resource.data.customStatus.text.size() <= 60
                  && request.resource.data.customStatus.emoji is string && request.resource.data.customStatus.emoji.size() <= 16))
          && (!('avatarHistory' in request.resource.data) || (request.resource.data.avatarHistory is list && request.resource.data.avatarHistory.size() <= 8))
          && (!('privacy' in request.resource.data) || request.resource.data.privacy is map)
          // blockedUids = lista de uids que a pessoa bloqueou (máx. 200); email espelha o e-mail do Auth
          && (!('blockedUids' in request.resource.data) || (request.resource.data.blockedUids is list && request.resource.data.blockedUids.size() <= 200))
          && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 254))
          && (!('profileTheme' in request.resource.data) || request.resource.data.profileTheme == null
              || (request.resource.data.profileTheme is map
                  && request.resource.data.profileTheme.primary is string && request.resource.data.profileTheme.primary.matches('^#[0-9a-fA-F]{6}$')
                  && request.resource.data.profileTheme.accent is string && request.resource.data.profileTheme.accent.matches('^#[0-9a-fA-F]{6}$')))
          && (!('profileEffect' in request.resource.data) || (request.resource.data.profileEffect is string && request.resource.data.profileEffect.size() <= 16))
          && (!('nameplate' in request.resource.data) || (request.resource.data.nameplate is string && request.resource.data.nameplate.size() <= 16))
          // notifPrefs = { servers:{id:nível}, channels:{id:nível}, dms:{id:nível} } (silenciar / só menções)
          && (!('notifPrefs' in request.resource.data) || request.resource.data.notifPrefs is map)
          // activity = { name, startedAt } ou null (jogo detectado pelo app desktop)
          && (!('activity' in request.resource.data) || request.resource.data.activity == null
              || (request.resource.data.activity is map && request.resource.data.activity.name is string
                  && request.resource.data.activity.name.size() <= 64))
          // username só pode mudar para um valor no formato válido — a
          // checagem de "já está em uso" é feita no client (settings.js)
          // antes de chamar updateDoc; aqui é só a validação de formato.
          && (request.resource.data.username == resource.data.username || isValidUsername(request.resource.data.username))
        );
    }
    // Um "admin" é definido pelo próprio campo isAdmin no doc do usuário
    // logado — campo que, por sua vez, NENHUMA regra permite o próprio
    // usuário setar (não está em isValidSelfProfileEdit acima), então só
    // vira true manualmente no console do Firebase.
    function isAdminUser() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }
    // Admin só pode tocar em role/primeSince/customBadges de QUALQUER
    // usuário — nada além disso (não pode mudar avatar, bio etc. de outros).
    function isValidAdminBadgeEdit() {
      return isAdminUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','primeSince','customBadges']);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid);
      allow update: if (isSelf(uid) && isValidSelfProfileEdit()) || isValidAdminBadgeEdit();
      // Excluir a própria conta (Configurações > Conta)
      allow delete: if isSelf(uid);

      match /socialLinks/{linkId} {
        allow read: if signedIn();
        allow write: if isSelf(uid);
      }
    }

    // ---------- Amizades ----------
    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.userIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.userIds;
      allow update: if signedIn() && request.auth.uid in resource.data.userIds;
    }

    // ---------- Mensagens diretas ----------
    // Bloqueio numa DM 1:1: se qualquer um dos dois bloqueou o outro, ninguém envia mensagem.
    function dmBlockedEitherWay(dmId) {
      let dm = get(/databases/$(database)/documents/directMessages/$(dmId)).data;
      return dm.participantIds.size() == 2
        && (request.auth.uid in get(/databases/$(database)/documents/users/$(dm.participantIds[0] == request.auth.uid ? dm.participantIds[1] : dm.participantIds[0])).data.get('blockedUids', [])
            || (dm.participantIds[0] == request.auth.uid ? dm.participantIds[1] : dm.participantIds[0]) in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('blockedUids', []));
    }
    // DM em grupo (isGroup == true): 3 a 10 pessoas, com nome (até 40) e dono (ownerId).
    //  · qualquer participante atualiza só o "ponteiro" da última mensagem;
    //  · o dono renomeia, adiciona e remove pessoas;
    //  · qualquer participante pode SAIR (remover só a si mesmo); se o dono sai, passa a posse a quem fica.
    // Numa DM 1:1 ninguém altera quem participa.
    function dmPointerOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['lastMessageAt', 'lastMessageAuthorId', 'lastMessagePreview']);
    }
    function isValidDmCreate() {
      let d = request.resource.data;
      return request.auth.uid in d.participantIds
        && d.participantIds is list
        && d.participantIds.size() >= 2 && d.participantIds.size() <= 10
        && (d.get('isGroup', false) != true
            ? d.participantIds.size() == 2
            : (d.participantIds.size() >= 3
               && d.get('ownerId', '') == request.auth.uid
               && d.get('name', '') is string && d.get('name', '').size() <= 40));
    }
    function isValidGroupUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return before.get('isGroup', false) == true
        && after.get('isGroup', false) == true
        && after.participantIds.size() >= 1 && after.participantIds.size() <= 10
        && (
          dmPointerOnly()
          // dono: nome, participantes
          || (before.get('ownerId', '') == request.auth.uid
              && changed.hasOnly(['name', 'participantIds'])
              && after.get('name', '') is string && after.get('name', '').size() <= 40
              && after.participantIds.size() >= 2
              && request.auth.uid in after.participantIds
              && after.get('ownerId', before.get('ownerId', '')) == before.get('ownerId', ''))
          // sair do grupo: só tira a si mesmo; se era o dono, a posse vai para alguém que fica
          || (changed.hasOnly(['participantIds', 'ownerId'])
              && !(request.auth.uid in after.participantIds)
              && after.participantIds.size() == before.participantIds.size() - 1
              && after.participantIds.hasAll(before.participantIds.removeAll([request.auth.uid]))
              && (before.get('ownerId', '') != request.auth.uid
                  ? !('ownerId' in changed)
                  : (after.participantIds.size() == 0 || after.get('ownerId', '') in after.participantIds)))
        );
    }
    match /directMessages/{dmId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && isValidDmCreate();
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds
        && (resource.data.get('isGroup', false) == true
            ? isValidGroupUpdate()
            : request.resource.data.participantIds == resource.data.participantIds);

      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)).data.participantIds;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)).data.participantIds
          && request.resource.data.authorId == request.auth.uid
          && !dmBlockedEitherWay(dmId);
        allow update: if signedIn()
          && (isValidMessageEdit() || isValidPollClose()
              || (request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)).data.participantIds
                  && (isValidReactionUpdate() || isValidVoteUpdate() || isValidPinUpdate() || isValidThreadCounterUpdate())));
        // Numa DM não existe moderação: só o próprio autor apaga o que escreveu.
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

        // Respostas do tópico numa DM (1:1 ou grupo): só participantes; bloqueio vale como nas mensagens.
        match /threadMessages/{replyId} {
          allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)).data.participantIds;
          allow create: if signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)).data.participantIds
            && isValidThreadReply()
            && !dmBlockedEitherWay(dmId);
          allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
        }
      }

      // "Digitando..." — cada pessoa só escreve no próprio doc (id = uid).
      match /typing/{uid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)).data.participantIds;
        allow write: if signedIn() && isSelf(uid);
      }
    }

    // ---------- Servidores ----------
    // Duas formas de editar o doc do servidor, mutuamente exclusivas:
    // (1) qualquer membro pode mexer SÓ em memberIds (entrar/sair/ser expulso);
    // (2) dono ou admin pode editar nome/descrição/ícone/banner, mas nunca
    //     ownerId ou memberIds por essa via (isso evitaria um admin se
    //     autopromover a dono, ou "roubar" o servidor).
    function isServerAdminOrOwner(serverId) {
      return isServerOwner(serverId)
        || myMemberDoc(serverId).role == 'admin';
    }
    // Editar nome/descrição/ícone/banner: dono, admin legado, ou membro com
    // a permissão granular 'manageServer' (cargo personalizado).
    function isValidServerInfoEdit(serverId) {
      return (isServerAdminOrOwner(serverId) || hasPermission(serverId, 'manageServer'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','iconUrl','bannerUrl','welcome','autoRoleId','visibility','rules'])
        // visibility ('public' | 'private'): só o dono muda
        && (!('visibility' in request.resource.data.diff(resource.data).affectedKeys())
            || (isServerOwner(serverId) && request.resource.data.visibility in ['public', 'private']))
        // welcome = { enabled, channelId, message } · autoRoleId = cargo dado a quem entra (ou null)
        && (!('welcome' in request.resource.data) || request.resource.data.welcome is map)
        // rules = { enabled, text (até 2000), version } — tela de regras com aceite
        && (!('rules' in request.resource.data) || (request.resource.data.rules is map
            && request.resource.data.rules.get('text', '') is string && request.resource.data.rules.get('text', '').size() <= 2000
            && request.resource.data.rules.get('enabled', false) is bool
            && request.resource.data.rules.get('version', 1) is int))
        && (!('autoRoleId' in request.resource.data) || request.resource.data.autoRoleId == null || request.resource.data.autoRoleId is string);
    }
    // Quem pode remover QUALQUER outro membro de memberIds (expulsar):
    // dono, admin legado, ou permissão granular 'manageMembers'.
    function canKickMembers(serverId) {
      return isServerAdminOrOwner(serverId) || hasPermission(serverId, 'manageMembers');
    }
    // Uma pessoa sempre pode remover A SI MESMA de memberIds (sair do
    // servidor, ou ser removida por quem tem permissão — ver
    // canKickMembers) — sem alterar mais ninguém na lista.
    function isSelfLeavingOnly(serverId) {
      return request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
        && !(request.auth.uid in request.resource.data.memberIds);
    }
    // Entrar no servidor: só é permitido ADICIONAR o próprio uid ao final
    // da lista (nunca remover terceiros nem adicionar outra pessoa em seu
    // lugar) — reflete exatamente como o client chama arrayUnion() ao
    // entrar por convite (ver joinServerByInviteCode em servers.js).
    function isSelfJoiningOnly(serverId) {
      return !(request.auth.uid in resource.data.memberIds)
        && !isBanned(serverId, request.auth.uid)
        && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
        && (resource.data.get('visibility', 'private') != 'private' || isJoiningWithNewMemberDoc(serverId));
    }
    // Servidor privado: entrar na lista de membros só vale junto com a CRIAÇÃO do doc de membro
    // (que carrega a prova do convite), na mesma gravação em lote. O `!exists` impede reaproveitar
    // um doc de membro antigo que tenha sobrado.
    function isJoiningWithNewMemberDoc(serverId) {
      return !exists(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid));
    }
    function isValidMemberIdsChange(serverId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && (isSelfLeavingOnly(serverId) || isSelfJoiningOnly(serverId) || canKickMembers(serverId));
    }
    // Antes, qualquer membro podia reescrever QUALQUER campo do próprio doc
    // de membro — inclusive `role`, o que permitiria se autopromover a
    // admin. Agora: ao entrar, só pode nascer nos dois formatos abaixo;
    // depois disso, só pode tocar em `nickname`. Tudo que dá poder (role,
    // roleIds, permissions) só o dono grava.
    function isValidSelfMemberJoin(serverId) {
      return (request.resource.data.role == 'owner' && isServerOwner(serverId)
              || request.resource.data.role == 'member')
        && (request.resource.data.get('roleIds', []) == [] || isAutoRoleGrant(serverId))
        && request.resource.data.get('permissions', {}) == {}
        && !isBanned(serverId, request.auth.uid)
        && (request.resource.data.role == 'owner' || !isPrivateServer(serverId) || isValidInviteJoin(serverId));
    }
    // Privado = visibility 'private' (e também servidores antigos sem o campo, como o app sempre tratou).
    function isPrivateServer(serverId) {
      return get(/databases/$(database)/documents/servers/$(serverId)).data.get('visibility', 'private') == 'private';
    }
    // Prova de convite no doc de membro (campo `inviteCode`): o convite existe, é DESTE servidor, está
    // no prazo, não esgotou — e foi consumido (uses + 1) na mesma gravação em lote (getAfter), o que
    // faz o limite de usos valer de verdade mesmo com várias pessoas entrando ao mesmo tempo.
    function isValidInviteJoin(serverId) {
      let code = request.resource.data.get('inviteCode', null);
      let inv = get(/databases/$(database)/documents/invites/$(code)).data;
      let invAfter = getAfter(/databases/$(database)/documents/invites/$(code)).data;
      return code is string
        && inv.serverId == serverId
        && (inv.get('expiresAt', null) == null || inv.expiresAt > request.time)
        && (inv.get('maxUses', null) == null || inv.get('uses', 0) < inv.maxUses)
        && invAfter.get('uses', 0) == inv.get('uses', 0) + 1;
    }
    // Quem entra pode nascer SÓ com o cargo automático que o servidor configurou (autoRoleId) —
    // e sem permissões (permissions continua {}), então não dá para se autopromover.
    function isAutoRoleGrant(serverId) {
      let autoRole = get(/databases/$(database)/documents/servers/$(serverId)).data.get('autoRoleId', null);
      return autoRole != null && request.resource.data.get('roleIds', []) == [autoRole];
    }
    function isValidSelfMemberEdit() {
      // nickname, e o aceite das regras (rulesVersion só pode ser um inteiro; rulesAcceptedAt é a hora do servidor)
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'rulesAcceptedAt', 'rulesVersion'])
        && (!('rulesVersion' in request.resource.data) || request.resource.data.rulesVersion is int)
        && (!('rulesAcceptedAt' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.rulesAcceptedAt == request.time);
    }

    // ---------- Moderação: banimento, castigo (timeout) e log de auditoria ----------
    // Banido = existe servers/{id}/bans/{uid}. Quem foi banido não consegue voltar
    // (nem por convite): ver isSelfJoiningOnly e isValidSelfMemberJoin.
    function isBanned(serverId, uid) {
      return exists(/databases/$(database)/documents/servers/$(serverId)/bans/$(uid));
    }
    // Castigo = `timeoutUntil` (+ `timeoutBy`) no doc do membro. Só quem pode expulsar
    // altera esses campos, e nunca no dono, em si mesmo ou — exceto o dono — em admins.
    function isValidTimeoutChange(serverId, uid) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timeoutUntil', 'timeoutBy'])
        && uid != get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId
        && uid != request.auth.uid
        && (resource.data.get('role', 'member') != 'admin' || isServerOwner(serverId));
    }
    // Em castigo = `timeoutUntil` ainda no futuro. Sem o campo (ou nulo) = livre. Quem não
    // tem doc de membro (conta antiga) também fica livre — por isso o exists() antes do get().
    function isTimedOut(serverId) {
      return exists(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid))
        && myMemberDoc(serverId).get('timeoutUntil', null) != null
        && myMemberDoc(serverId).get('timeoutUntil', null) > request.time;
    }
    // Quem enxerga (e alimenta) o log de auditoria: quem modera, gerencia canais ou o servidor.
    function canViewAuditLog(serverId) {
      return canKickMembers(serverId) || canManageChannels(serverId) || hasPermission(serverId, 'manageServer')
        || hasPermission(serverId, 'viewAuditLog');
    }
    // Apagar mensagem de outra pessoa e fixar mensagem: cargo com "Gerenciar mensagens" ou quem gerencia canais.
    function canModerateMessages(serverId) {
      return canManageChannels(serverId) || hasPermission(serverId, 'manageMessages');
    }
    // Canal privado (channels/{id}.private == true): só lê/escreve quem gerencia canais ou tem um
    // cargo listado em viewRoleIds (cópia, gravada pelo app, dos cargos com "Ver canal: permitir").
    // O doc do canal em si continua legível por todo membro (a lista de canais precisa dele);
    // o que fica protegido é o CONTEÚDO: mensagens, "digitando", presença e sinalização de voz.
    function canAccessChannel(serverId, channelId) {
      let ch = get(/databases/$(database)/documents/servers/$(serverId)/channels/$(channelId)).data;
      return !ch.get('private', false)
        || isServerOwner(serverId)
        || canManageChannels(serverId)
        || myMemberDoc(serverId).get('roleIds', []).hasAny(ch.get('viewRoleIds', []));
    }

    // Modo lento (channels/{id}.slowmodeSeconds): a mensagem só é aceita se vier no MESMO lote que o
    // carimbo slowmode/{uid}.lastAt == request.time e se o carimbo anterior tem mais que o intervalo.
    // Quem gerencia canais (e o dono) é isento. Limite honesto: um cliente adulterado ainda consegue
    // mandar várias mensagens num único lote; o que está barrado é mandar de novo antes do intervalo.
    function slowmodeOk(serverId, channelId) {
      let secs = get(/databases/$(database)/documents/servers/$(serverId)/channels/$(channelId)).data.get('slowmodeSeconds', 0);
      let sd = /databases/$(database)/documents/servers/$(serverId)/channels/$(channelId)/slowmode/$(request.auth.uid);
      return secs == 0
        || canManageChannels(serverId)
        || (getAfter(sd).data.lastAt == request.time
            && (!exists(sd) || get(sd).data.lastAt + duration.value(secs, 's') <= request.time));
    }

    // Regras do servidor com aceite: se `rules.enabled`, só envia mensagem quem aceitou a versão atual
    // (member.rulesVersion >= rules.version). O dono é isento.
    function rulesOk(serverId) {
      let r = get(/databases/$(database)/documents/servers/$(serverId)).data.get('rules', {});
      return !r.get('enabled', false)
        || isServerOwner(serverId)
        || !exists(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid)) // conta antiga sem doc de membro
        || myMemberDoc(serverId).get('rulesVersion', 0) >= r.get('version', 1);
    }
    // Canal de anúncios (channels/{id}.announcement == true): só quem gerencia canais publica.
    function canPostInChannel(serverId, channelId) {
      return !get(/databases/$(database)/documents/servers/$(serverId)/channels/$(channelId)).data.get('announcement', false)
        || isServerOwner(serverId) || canManageChannels(serverId);
    }
    // Editar identidade do servidor (eventos, emojis do servidor): dono, admin legado ou cargo "Gerenciar servidor".
    function canManageServerInfoRule(serverId) {
      return isServerOwner(serverId) || myMemberDoc(serverId).get('role', 'member') == 'admin' || hasPermission(serverId, 'manageServer');
    }

    match /servers/{serverId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == request.resource.data.ownerId;
      allow update: if signedIn() && (isValidMemberIdsChange(serverId) || isValidServerInfoEdit(serverId));
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      match /categories/{catId} {
        allow read: if signedIn() && isServerMember(serverId);
        allow write: if signedIn() && canManageChannels(serverId);
      }

      // Cargos personalizados — leitura para qualquer membro (para mostrar
      // nome/cor nas listas), escrita só pelo dono (criar/editar/excluir
      // cargos e decidir quem tem qual permissão é um ato de confiança
      // maior, deixado fora do próprio sistema de permissões — mesma lógica
      // já usada para promover/rebaixar o cargo legado 'admin').
      match /roles/{roleId} {
        allow read: if signedIn() && isServerMember(serverId);
        allow write: if signedIn() && isServerOwner(serverId);
      }

      match /channels/{channelId} {
        allow read: if signedIn() && isServerMember(serverId);
        allow write: if signedIn() && canManageChannels(serverId);
        // Qualquer membro pode atualizar SÓ o "ponteiro" de última
        // atividade do canal (gravado a cada mensagem enviada — ver
        // sendCurrentMessage/sendAttachmentMessage em chat.js), usado pro
        // badge de não lida na sidebar. Renomear, mudar tipo, overwrites
        // etc. continuam exclusivos de quem gerencia canais (regra acima).
        allow update: if signedIn() && isServerMember(serverId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'lastMessageAuthorId', 'lastMentionedUids'])
          // lastMentionedUids: quem foi @mencionado/respondido na última mensagem (badge do nível "só menções")
          && request.resource.data.get('lastMentionedUids', []) is list;

        match /messages/{msgId} {
          allow read: if signedIn() && isServerMember(serverId) && canAccessChannel(serverId, channelId);
          allow create: if signedIn() && isServerMember(serverId) && request.resource.data.authorId == request.auth.uid
            && canAccessChannel(serverId, channelId)
            && canPostInChannel(serverId, channelId) && rulesOk(serverId)
            && !isTimedOut(serverId)
            && slowmodeOk(serverId, channelId);
          allow update: if signedIn() && isServerMember(serverId) && canAccessChannel(serverId, channelId)
            && (isValidMessageEdit() || isValidReactionUpdate() || isValidVoteUpdate() || isValidPollClose()
                || (isValidThreadCounterUpdate() && !isTimedOut(serverId))
                || (isValidPinUpdate() && canModerateMessages(serverId)));
          // O autor apaga a própria mensagem; quem tem "Gerenciar mensagens" (ou gerencia
          // canais) apaga a de qualquer um.
          allow delete: if signedIn() && isServerMember(serverId) && canAccessChannel(serverId, channelId)
            && (resource.data.authorId == request.auth.uid || canModerateMessages(serverId));

          // Respostas do tópico: leem/escrevem quem enxerga o canal; castigo barra responder;
          // o autor apaga a própria resposta e quem modera apaga a de qualquer um.
          match /threadMessages/{replyId} {
            allow read: if signedIn() && isServerMember(serverId) && canAccessChannel(serverId, channelId);
            allow create: if signedIn() && isServerMember(serverId) && canAccessChannel(serverId, channelId)
              && !isTimedOut(serverId) && rulesOk(serverId) && isValidThreadReply();
            allow delete: if signedIn() && isServerMember(serverId) && canAccessChannel(serverId, channelId)
              && (resource.data.authorId == request.auth.uid || canModerateMessages(serverId));
          }
        }

        // Carimbo do modo lento: cada pessoa grava só o próprio, sempre com o horário do servidor.
        match /slowmode/{uid} {
          allow read: if signedIn() && isSelf(uid);
          allow create, update: if signedIn() && isSelf(uid) && isServerMember(serverId)
            && request.resource.data.keys().hasOnly(['lastAt'])
            && request.resource.data.lastAt == request.time;
        }

        match /voicePresence/{uid} {
          allow read: if signedIn() && isServerMember(serverId) && canAccessChannel(serverId, channelId);
          allow write: if signedIn() && isSelf(uid) && canAccessChannel(serverId, channelId);
        }

        // "Digitando..." — cada pessoa só escreve no próprio doc (id = uid).
        match /typing/{uid} {
          allow read: if signedIn() && isServerMember(serverId) && canAccessChannel(serverId, channelId);
          allow write: if signedIn() && isSelf(uid) && canAccessChannel(serverId, channelId);
        }

        match /voiceSignaling/{pairId} {
          allow read, write: if signedIn() && isServerMember(serverId) && canAccessChannel(serverId, channelId);

          match /candidates/{candId} {
            allow read, write: if signedIn() && isServerMember(serverId) && canAccessChannel(serverId, channelId);
          }
        }
      }

      // Eventos agendados: qualquer membro lê e marca "tenho interesse" (só o campo interestedUids);
      // criar/editar/apagar é de quem gerencia o servidor (o criador também apaga o seu).
      match /events/{eventId} {
        allow read: if signedIn() && isServerMember(serverId);
        allow create: if signedIn() && isServerMember(serverId) && canManageServerInfoRule(serverId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
          && request.resource.data.get('description', '') is string && request.resource.data.get('description', '').size() <= 300
          && request.resource.data.startsAt is timestamp
          && request.resource.data.get('interestedUids', []) == [];
        allow update: if signedIn() && isServerMember(serverId)
          && (canManageServerInfoRule(serverId)
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUids'])
                  && request.resource.data.interestedUids is list
                  && request.resource.data.interestedUids.size() <= 5000
                  // só entra ou sai o PRÓPRIO uid, de um em um
                  && ((request.resource.data.interestedUids.hasAll(resource.data.interestedUids)
                       && request.resource.data.interestedUids.size() == resource.data.interestedUids.size() + 1
                       && request.resource.data.interestedUids.hasAny([request.auth.uid])
                       && !resource.data.interestedUids.hasAny([request.auth.uid]))
                      || (resource.data.interestedUids.hasAll(request.resource.data.interestedUids)
                          && request.resource.data.interestedUids.size() == resource.data.interestedUids.size() - 1
                          && resource.data.interestedUids.hasAny([request.auth.uid])
                          && !request.resource.data.interestedUids.hasAny([request.auth.uid])))));
        allow delete: if signedIn() && isServerMember(serverId)
          && (canManageServerInfoRule(serverId) || resource.data.createdBy == request.auth.uid);
      }

      match /members/{uid} {
        allow read: if signedIn() && isServerMember(serverId);
        allow create: if signedIn() && isSelf(uid) && isValidSelfMemberJoin(serverId);
        allow update: if signedIn() && ((isSelf(uid) && isValidSelfMemberEdit()) || isServerOwner(serverId)
                                        || (canKickMembers(serverId) && isValidTimeoutChange(serverId, uid)));
        allow delete: if signedIn() && (isSelf(uid) || isServerOwner(serverId) || canKickMembers(serverId));
      }

      // Banidos — só quem pode expulsar lê/cria/remove. Não dá para banir o dono, a si
      // mesmo nem (exceto o dono) um admin. A pessoa banida NÃO consegue ler esta lista.
      match /bans/{uid} {
        allow read: if signedIn() && isServerMember(serverId) && canKickMembers(serverId);
        allow create: if signedIn() && isServerMember(serverId) && canKickMembers(serverId)
          && request.resource.data.uid == uid
          && request.resource.data.bannedBy == request.auth.uid
          && uid != request.auth.uid
          && uid != get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId
          && (get(/databases/$(database)/documents/servers/$(serverId)/members/$(uid)).data.get('role', 'member') != 'admin'
              || isServerOwner(serverId));
        allow delete: if signedIn() && isServerMember(serverId) && canKickMembers(serverId);
      }

      // Log de auditoria — só acrescenta e lê (nunca edita nem apaga), e cada entrada
      // precisa ser do próprio autor da ação.
      match /auditLog/{entryId} {
        allow read: if signedIn() && isServerMember(serverId) && canViewAuditLog(serverId);
        allow create: if signedIn() && isServerMember(serverId) && canViewAuditLog(serverId)
          && request.resource.data.actorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---------- Convites ----------
    match /invites/{code} {
      // get: qualquer pessoa logada com o código (é assim que se entra). list: só os convites
      // que você criou ou, se você administra/gerencia o servidor, os do servidor — ninguém
      // consegue "varrer" a coleção atrás de códigos de servidores privados.
      allow get: if signedIn();
      allow list: if signedIn()
        && (resource.data.createdBy == request.auth.uid
            || isServerAdminOrOwner(resource.data.serverId)
            || hasPermission(resource.data.serverId, 'manageServer'));
      // Criar: só quem é membro do servidor do convite (senão qualquer conta fabricaria convites
      // de qualquer servidor) e sempre com uses = 0.
      allow create: if signedIn() && request.auth.uid == request.resource.data.createdBy
        && isServerMember(request.resource.data.serverId)
        && request.resource.data.get('uses', 0) == 0;
      // Qualquer pessoa só pode registrar UM uso por vez (uses + 1), e só num convite ainda
      // válido (dentro do limite e do prazo). Ninguém reescreve limite nem validade.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
        && request.resource.data.uses == resource.data.get('uses', 0) + 1
        && (resource.data.get('maxUses', null) == null || request.resource.data.uses <= resource.data.maxUses)
        && (resource.data.get('expiresAt', null) == null || resource.data.expiresAt > request.time);
      // Revogar: quem criou o convite, ou quem administra/gerencia o servidor.
      allow delete: if signedIn()
        && (resource.data.createdBy == request.auth.uid
            || isServerAdminOrOwner(resource.data.serverId)
            || hasPermission(resource.data.serverId, 'manageServer'));
    }

    // ---------- Chamadas (DM) ----------
    match /calls/{callId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow create: if signedIn() && request.auth.uid == request.resource.data.callerId;
      allow update: if signedIn() && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);

      match /candidates/{candId} {
        allow read, write: if signedIn();
      }
    }

    // Denúncias: qualquer usuário cria a sua (como ele mesmo, status 'open'); só o autor,
    // admins do app e quem pode banir no servidor da denúncia leem; só moderação muda o status.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetUid is string && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.kind in ['user', 'message']
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 30
        && request.resource.data.get('details', '').size() <= 300
        && request.resource.data.get('snippet', '').size() <= 300
        && request.resource.data.get('targetName', '').size() <= 60
        && request.resource.data.status == 'open';
      allow read: if signedIn() && (resource.data.reporterId == request.auth.uid || isAdminUser()
        || (resource.data.get('serverId', null) != null && canKickMembers(resource.data.serverId)));
      allow update: if signedIn() && (isAdminUser()
          || (resource.data.get('serverId', null) != null && canKickMembers(resource.data.serverId)))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt']);
      allow delete: if isAdminUser();
    }

    // ---------- Emojis personalizados (biblioteca compartilhada) ----------
    // Cada emoji é do criador (uploaderId). Leitura é aberta porque a imagem precisa
    // aparecer nas mensagens de quem tem acesso; quem PODE USAR é decidido por
    // allowedUserIds, que só o criador altera (ao aceitar um pedido).
    match /customEmojis/{emojiId} {
      allow read: if signedIn();
      // Emoji de servidor (campo serverId): só quem gerencia aquele servidor cria; todo membro pode usar.
      allow create: if signedIn() && request.resource.data.uploaderId == request.auth.uid
        && request.resource.data.get('allowedUserIds', []) == []
        && (request.resource.data.get('serverId', null) == null
            || (isServerMember(request.resource.data.serverId) && canManageServerInfoRule(request.resource.data.serverId)));
      allow update: if signedIn() && resource.data.uploaderId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allowedUserIds']);
      allow delete: if signedIn() && (resource.data.uploaderId == request.auth.uid
        || (resource.data.get('serverId', null) != null && canManageServerInfoRule(resource.data.serverId)));
    }

    // Pedidos de acesso a emojis de outras pessoas. Quem pede cria (status 'pending');
    // só o criador do emoji muda o status; os dois lados podem apagar o pedido.
    match /customEmojiRequests/{requestId} {
      allow read: if signedIn() && (resource.data.requesterId == request.auth.uid
        || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn()
        && requestId == request.resource.data.emojiId + '_' + request.auth.uid
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.ownerId != request.auth.uid
        && get(/databases/$(database)/documents/customEmojis/$(request.resource.data.emojiId)).data.uploaderId == request.resource.data.ownerId;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved', 'denied'];
      allow delete: if signedIn() && (resource.data.requesterId == request.auth.uid
        || resource.data.ownerId == request.auth.uid);
    }

    // ---------- Estado de leitura (badge de "não lidas") ----------
    // Um doc por (uid, conversationId) — só o próprio dono lê e escreve o
    // seu (ver readStateDoc em db.js, chamado por unread.js).
    match /readStates/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
    }
    // ---------- Índice de anexos ("Arquivos" no rail) ----------
    // Um doc leve por anexo enviado, espelhando o que já foi gravado na
    // mensagem em si (channelMessages/dmMessages) — sem isso, listar "meus
    // arquivos" exigiria varrer toda conversa que a pessoa já participou.
    // Só o próprio remetente lê/escreve o seu; nunca dá pra reescrever um
    // registro existente, só criar ou apagar (tirar da lista).
    match /attachments/{attachmentId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
