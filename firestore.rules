rules_version = '2';

// ============================================================
// G.K.IO — Regras de segurança do Firestore (ponto de partida)
// Cole isto em: Console do Firebase > Firestore Database > Regras.
// São regras razoáveis para o MVP/uso com amigos — antes de um
// lançamento público mais amplo, revise com mais rigor (ex.:
// validação de schema de cada campo, rate limiting via App Check).
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return request.auth.uid == uid; }
    function isServerMember(serverId) {
      return request.auth.uid in get(/databases/$(database)/documents/servers/$(serverId)).data.memberIds;
    }
    function isServerOwner(serverId) {
      return request.auth.uid == get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId;
    }
    function myMemberDoc(serverId) {
      return get(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid)).data;
    }
    // Cargos personalizados (ver servers/{id}/roles): a app calcula a união
    // das permissões dos cargos atribuídos e grava uma cópia "achatada" no
    // próprio doc do membro (campo `permissions`), porque as Rules não
    // conseguem percorrer um array de ids e consultar cada cargo dentro de
    // uma mesma regra. Só o dono grava esse campo (ver match /members
    // abaixo), então essa cópia é confiável.
    function hasPermission(serverId, key) {
      return myMemberDoc(serverId).get('permissions', {}).get(key, false) == true;
    }
    // Só o dono do servidor, um membro com cargo legado 'admin', ou um
    // membro com a permissão granular correspondente pode gerenciar
    // canais/categorias. Membros comuns só têm leitura.
    function canManageChannels(serverId) {
      return isServerOwner(serverId)
        || myMemberDoc(serverId).role == 'admin'
        || hasPermission(serverId, 'manageChannels');
    }
    // Edição de mensagem: só o autor, e só pode alterar 'content' e 'editedAt'
    // (autorId, createdAt e anexos ficam travados).
    function isValidMessageEdit() {
      return resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'editedAt']);
    }
    // Reações: diferente da edição, QUALQUER pessoa que enxerga a conversa
    // pode mexer — só no campo 'reactions', sem tocar em mais nada da
    // mensagem (autor, conteúdo, anexo etc. continuam travados). A regra
    // não valida que a pessoa só adicionou/removeu o PRÓPRIO uid dentro do
    // mapa (o Firestore Rules não consegue inspecionar o conteúdo de um
    // arrayUnion/arrayRemove dentro de um mapa aninhado) — mitigado no
    // client, que só chama arrayUnion(auth.uid)/arrayRemove(auth.uid).
    function isValidReactionUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    // Votos de enquete: qualquer pessoa da conversa, só no campo 'votes' e só
    // enquanto a enquete não foi encerrada.
    function isValidVoteUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && !resource.data.get('pollClosed', false)
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    // Encerrar a enquete: só o autor, só o campo 'pollClosed'.
    function isValidPollClose() {
      return resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pollClosed'])
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    // Fixar/desafixar mensagem: só os campos de pin. QUEM pode fixar é decidido
    // por quem chama (canal: quem gerencia canais; DM: qualquer participante).
    function isValidPinUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned', 'pinnedBy', 'pinnedAt'])
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // ---------- Usuários e perfil ----------
    // Campos de status Prime (role, primeSince, customBadges) NUNCA podem
    // ser alterados pelo próprio usuário via client — só mudam manualmente
    // no console do Firebase, ou futuramente via Cloud Function com Admin
    // SDK (ex: webhook de um gateway de pagamento), que ignora estas regras.
    function isValidUsername(u) {
      return u is string && u.size() >= 3 && u.size() <= 32 && u.matches('^[a-z0-9_-]+$');
    }
    function isValidSelfProfileEdit() {
      return !('role' in resource.data) // primeira escrita (criação do doc) passa livre
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName','avatarUrl','bannerUrl','bannerType','bio','statusPresence','lastActiveAt','tag','frameStyle','username','fcmToken','wallpaper','wallpaperUrl','activity','notifPrefs'])
          // notifPrefs = { servers:{id:nível}, channels:{id:nível}, dms:{id:nível} } (silenciar / só menções)
          && (!('notifPrefs' in request.resource.data) || request.resource.data.notifPrefs is map)
          // activity = { name, startedAt } ou null (jogo detectado pelo app desktop)
          && (!('activity' in request.resource.data) || request.resource.data.activity == null
              || (request.resource.data.activity is map && request.resource.data.activity.name is string
                  && request.resource.data.activity.name.size() <= 64))
          // username só pode mudar para um valor no formato válido — a
          // checagem de "já está em uso" é feita no client (settings.js)
          // antes de chamar updateDoc; aqui é só a validação de formato.
          && (request.resource.data.username == resource.data.username || isValidUsername(request.resource.data.username))
        );
    }
    // Um "admin" é definido pelo próprio campo isAdmin no doc do usuário
    // logado — campo que, por sua vez, NENHUMA regra permite o próprio
    // usuário setar (não está em isValidSelfProfileEdit acima), então só
    // vira true manualmente no console do Firebase.
    function isAdminUser() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }
    // Admin só pode tocar em role/primeSince/customBadges de QUALQUER
    // usuário — nada além disso (não pode mudar avatar, bio etc. de outros).
    function isValidAdminBadgeEdit() {
      return isAdminUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','primeSince','customBadges']);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid);
      allow update: if (isSelf(uid) && isValidSelfProfileEdit()) || isValidAdminBadgeEdit();

      match /socialLinks/{linkId} {
        allow read: if signedIn();
        allow write: if isSelf(uid);
      }
    }

    // ---------- Amizades ----------
    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.userIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.userIds;
      allow update: if signedIn() && request.auth.uid in resource.data.userIds;
    }

    // ---------- Mensagens diretas ----------
    match /directMessages/{dmId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds;

      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)).data.participantIds;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)).data.participantIds
          && request.resource.data.authorId == request.auth.uid;
        allow update: if signedIn()
          && (isValidMessageEdit() || isValidPollClose()
              || (request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)).data.participantIds
                  && (isValidReactionUpdate() || isValidVoteUpdate() || isValidPinUpdate())));
        // Numa DM não existe moderação: só o próprio autor apaga o que escreveu.
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }

      // "Digitando..." — cada pessoa só escreve no próprio doc (id = uid).
      match /typing/{uid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/directMessages/$(dmId)).data.participantIds;
        allow write: if signedIn() && isSelf(uid);
      }
    }

    // ---------- Servidores ----------
    // Duas formas de editar o doc do servidor, mutuamente exclusivas:
    // (1) qualquer membro pode mexer SÓ em memberIds (entrar/sair/ser expulso);
    // (2) dono ou admin pode editar nome/descrição/ícone/banner, mas nunca
    //     ownerId ou memberIds por essa via (isso evitaria um admin se
    //     autopromover a dono, ou "roubar" o servidor).
    function isServerAdminOrOwner(serverId) {
      return isServerOwner(serverId)
        || myMemberDoc(serverId).role == 'admin';
    }
    // Editar nome/descrição/ícone/banner: dono, admin legado, ou membro com
    // a permissão granular 'manageServer' (cargo personalizado).
    function isValidServerInfoEdit(serverId) {
      return (isServerAdminOrOwner(serverId) || hasPermission(serverId, 'manageServer'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','iconUrl','bannerUrl','welcome','autoRoleId'])
        // welcome = { enabled, channelId, message } · autoRoleId = cargo dado a quem entra (ou null)
        && (!('welcome' in request.resource.data) || request.resource.data.welcome is map)
        && (!('autoRoleId' in request.resource.data) || request.resource.data.autoRoleId == null || request.resource.data.autoRoleId is string);
    }
    // Quem pode remover QUALQUER outro membro de memberIds (expulsar):
    // dono, admin legado, ou permissão granular 'manageMembers'.
    function canKickMembers(serverId) {
      return isServerAdminOrOwner(serverId) || hasPermission(serverId, 'manageMembers');
    }
    // Uma pessoa sempre pode remover A SI MESMA de memberIds (sair do
    // servidor, ou ser removida por quem tem permissão — ver
    // canKickMembers) — sem alterar mais ninguém na lista.
    function isSelfLeavingOnly(serverId) {
      return request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
        && !(request.auth.uid in request.resource.data.memberIds);
    }
    // Entrar no servidor: só é permitido ADICIONAR o próprio uid ao final
    // da lista (nunca remover terceiros nem adicionar outra pessoa em seu
    // lugar) — reflete exatamente como o client chama arrayUnion() ao
    // entrar por convite (ver joinServerByInviteCode em servers.js).
    function isSelfJoiningOnly(serverId) {
      return !(request.auth.uid in resource.data.memberIds)
        && !isBanned(serverId, request.auth.uid)
        && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid]);
    }
    function isValidMemberIdsChange(serverId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && (isSelfLeavingOnly(serverId) || isSelfJoiningOnly(serverId) || canKickMembers(serverId));
    }
    // Antes, qualquer membro podia reescrever QUALQUER campo do próprio doc
    // de membro — inclusive `role`, o que permitiria se autopromover a
    // admin. Agora: ao entrar, só pode nascer nos dois formatos abaixo;
    // depois disso, só pode tocar em `nickname`. Tudo que dá poder (role,
    // roleIds, permissions) só o dono grava.
    function isValidSelfMemberJoin(serverId) {
      return (request.resource.data.role == 'owner' && isServerOwner(serverId)
              || request.resource.data.role == 'member')
        && (request.resource.data.get('roleIds', []) == [] || isAutoRoleGrant(serverId))
        && request.resource.data.get('permissions', {}) == {}
        && !isBanned(serverId, request.auth.uid);
    }
    // Quem entra pode nascer SÓ com o cargo automático que o servidor configurou (autoRoleId) —
    // e sem permissões (permissions continua {}), então não dá para se autopromover.
    function isAutoRoleGrant(serverId) {
      let autoRole = get(/databases/$(database)/documents/servers/$(serverId)).data.get('autoRoleId', null);
      return autoRole != null && request.resource.data.get('roleIds', []) == [autoRole];
    }
    function isValidSelfMemberEdit() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname']);
    }

    // ---------- Moderação: banimento, castigo (timeout) e log de auditoria ----------
    // Banido = existe servers/{id}/bans/{uid}. Quem foi banido não consegue voltar
    // (nem por convite): ver isSelfJoiningOnly e isValidSelfMemberJoin.
    function isBanned(serverId, uid) {
      return exists(/databases/$(database)/documents/servers/$(serverId)/bans/$(uid));
    }
    // Castigo = `timeoutUntil` (+ `timeoutBy`) no doc do membro. Só quem pode expulsar
    // altera esses campos, e nunca no dono, em si mesmo ou — exceto o dono — em admins.
    function isValidTimeoutChange(serverId, uid) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timeoutUntil', 'timeoutBy'])
        && uid != get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId
        && uid != request.auth.uid
        && (resource.data.get('role', 'member') != 'admin' || isServerOwner(serverId));
    }
    // Em castigo = `timeoutUntil` ainda no futuro. Sem o campo (ou nulo) = livre. Quem não
    // tem doc de membro (conta antiga) também fica livre — por isso o exists() antes do get().
    function isTimedOut(serverId) {
      return exists(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid))
        && myMemberDoc(serverId).get('timeoutUntil', null) != null
        && myMemberDoc(serverId).get('timeoutUntil', null) > request.time;
    }
    // Quem enxerga (e alimenta) o log de auditoria: quem modera, gerencia canais ou o servidor.
    function canViewAuditLog(serverId) {
      return canKickMembers(serverId) || canManageChannels(serverId) || hasPermission(serverId, 'manageServer');
    }

    match /servers/{serverId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == request.resource.data.ownerId;
      allow update: if signedIn() && (isValidMemberIdsChange(serverId) || isValidServerInfoEdit(serverId));
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      match /categories/{catId} {
        allow read: if signedIn() && isServerMember(serverId);
        allow write: if signedIn() && canManageChannels(serverId);
      }

      // Cargos personalizados — leitura para qualquer membro (para mostrar
      // nome/cor nas listas), escrita só pelo dono (criar/editar/excluir
      // cargos e decidir quem tem qual permissão é um ato de confiança
      // maior, deixado fora do próprio sistema de permissões — mesma lógica
      // já usada para promover/rebaixar o cargo legado 'admin').
      match /roles/{roleId} {
        allow read: if signedIn() && isServerMember(serverId);
        allow write: if signedIn() && isServerOwner(serverId);
      }

      match /channels/{channelId} {
        allow read: if signedIn() && isServerMember(serverId);
        allow write: if signedIn() && canManageChannels(serverId);
        // Qualquer membro pode atualizar SÓ o "ponteiro" de última
        // atividade do canal (gravado a cada mensagem enviada — ver
        // sendCurrentMessage/sendAttachmentMessage em chat.js), usado pro
        // badge de não lida na sidebar. Renomear, mudar tipo, overwrites
        // etc. continuam exclusivos de quem gerencia canais (regra acima).
        allow update: if signedIn() && isServerMember(serverId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'lastMessageAuthorId', 'lastMentionedUids'])
          // lastMentionedUids: quem foi @mencionado/respondido na última mensagem (badge do nível "só menções")
          && request.resource.data.get('lastMentionedUids', []) is list;

        match /messages/{msgId} {
          allow read: if signedIn() && isServerMember(serverId);
          allow create: if signedIn() && isServerMember(serverId) && request.resource.data.authorId == request.auth.uid
            && !isTimedOut(serverId);
          allow update: if signedIn() && isServerMember(serverId)
            && (isValidMessageEdit() || isValidReactionUpdate() || isValidVoteUpdate() || isValidPollClose()
                || (isValidPinUpdate() && canManageChannels(serverId)));
          // O autor apaga a própria mensagem; quem modera o canal apaga a de
          // qualquer um (mesma régua usada para gerenciar canais).
          allow delete: if signedIn() && isServerMember(serverId)
            && (resource.data.authorId == request.auth.uid || canManageChannels(serverId));
        }

        match /voicePresence/{uid} {
          allow read: if signedIn() && isServerMember(serverId);
          allow write: if signedIn() && isSelf(uid);
        }

        // "Digitando..." — cada pessoa só escreve no próprio doc (id = uid).
        match /typing/{uid} {
          allow read: if signedIn() && isServerMember(serverId);
          allow write: if signedIn() && isSelf(uid);
        }

        match /voiceSignaling/{pairId} {
          allow read, write: if signedIn() && isServerMember(serverId);

          match /candidates/{candId} {
            allow read, write: if signedIn() && isServerMember(serverId);
          }
        }
      }

      match /members/{uid} {
        allow read: if signedIn() && isServerMember(serverId);
        allow create: if signedIn() && isSelf(uid) && isValidSelfMemberJoin(serverId);
        allow update: if signedIn() && ((isSelf(uid) && isValidSelfMemberEdit()) || isServerOwner(serverId)
                                        || (canKickMembers(serverId) && isValidTimeoutChange(serverId, uid)));
        allow delete: if signedIn() && (isSelf(uid) || isServerOwner(serverId) || canKickMembers(serverId));
      }

      // Banidos — só quem pode expulsar lê/cria/remove. Não dá para banir o dono, a si
      // mesmo nem (exceto o dono) um admin. A pessoa banida NÃO consegue ler esta lista.
      match /bans/{uid} {
        allow read: if signedIn() && isServerMember(serverId) && canKickMembers(serverId);
        allow create: if signedIn() && isServerMember(serverId) && canKickMembers(serverId)
          && request.resource.data.uid == uid
          && request.resource.data.bannedBy == request.auth.uid
          && uid != request.auth.uid
          && uid != get(/databases/$(database)/documents/servers/$(serverId)).data.ownerId
          && (get(/databases/$(database)/documents/servers/$(serverId)/members/$(uid)).data.get('role', 'member') != 'admin'
              || isServerOwner(serverId));
        allow delete: if signedIn() && isServerMember(serverId) && canKickMembers(serverId);
      }

      // Log de auditoria — só acrescenta e lê (nunca edita nem apaga), e cada entrada
      // precisa ser do próprio autor da ação.
      match /auditLog/{entryId} {
        allow read: if signedIn() && isServerMember(serverId) && canViewAuditLog(serverId);
        allow create: if signedIn() && isServerMember(serverId) && canViewAuditLog(serverId)
          && request.resource.data.actorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---------- Convites ----------
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == request.resource.data.createdBy;
      // Qualquer pessoa só pode registrar UM uso por vez (uses + 1), e só num convite ainda
      // válido (dentro do limite e do prazo). Ninguém reescreve limite nem validade.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
        && request.resource.data.uses == resource.data.get('uses', 0) + 1
        && (resource.data.get('maxUses', null) == null || request.resource.data.uses <= resource.data.maxUses)
        && (resource.data.get('expiresAt', null) == null || resource.data.expiresAt > request.time);
      // Revogar: quem criou o convite, ou quem administra/gerencia o servidor.
      allow delete: if signedIn()
        && (resource.data.createdBy == request.auth.uid
            || isServerAdminOrOwner(resource.data.serverId)
            || hasPermission(resource.data.serverId, 'manageServer'));
    }

    // ---------- Chamadas (DM) ----------
    match /calls/{callId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow create: if signedIn() && request.auth.uid == request.resource.data.callerId;
      allow update: if signedIn() && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);

      match /candidates/{candId} {
        allow read, write: if signedIn();
      }
    }

    // ---------- Emojis personalizados (biblioteca compartilhada) ----------
    match /customEmojis/{emojiId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uploaderId == request.auth.uid;
      allow delete: if signedIn() && resource.data.uploaderId == request.auth.uid;
    }

    // ---------- Estado de leitura (badge de "não lidas") ----------
    // Um doc por (uid, conversationId) — só o próprio dono lê e escreve o
    // seu (ver readStateDoc em db.js, chamado por unread.js).
    match /readStates/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
    }
    // ---------- Índice de anexos ("Arquivos" no rail) ----------
    // Um doc leve por anexo enviado, espelhando o que já foi gravado na
    // mensagem em si (channelMessages/dmMessages) — sem isso, listar "meus
    // arquivos" exigiria varrer toda conversa que a pessoa já participou.
    // Só o próprio remetente lê/escreve o seu; nunca dá pra reescrever um
    // registro existente, só criar ou apagar (tirar da lista).
    match /attachments/{attachmentId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
