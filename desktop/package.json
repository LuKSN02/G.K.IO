{
  "name": "gkio-desktop",
  "version": "1.6.1",
  "description": "G.K.IO — app desktop (Electron)",
  "main": "main.js",
  "author": "G.K.IO",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.gkio.desktop",
    "productName": "G.K.IO",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "games.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "web",
        "filter": [
          "index.html",
          "manifest.json",
          "css/**",
          "js/**",
          "img/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "../img/favicon-512.png",
      "category": "Network"
    },
    "mac": {
      "target": "dmg",
      "icon": "../img/favicon-512.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "luksn02",
        "repo": "G.K.IO"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "G.K.IO",
      "uninstallDisplayName": "G.K.IO",
      "deleteAppDataOnUninstall": false,
      "language": "1046",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "artifactName": "G.K.IO-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "G.K.IO-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
