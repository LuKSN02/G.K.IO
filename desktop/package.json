{
  "name": "gkio-desktop",
  "version": "1.0.0",
  "description": "G.K.IO — app desktop (Electron)",
  "main": "main.js",
  "author": "G.K.IO",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.gkio.desktop",
    "productName": "G.K.IO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "web",
        "filter": [
          "index.html",
          "manifest.json",
          "css/**",
          "js/**",
          "img/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../img/favicon-512.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "../img/favicon-512.png",
      "category": "Network"
    },
    "mac": {
      "target": "dmg",
      "icon": "../img/favicon-512.png"
    }
  }
}
